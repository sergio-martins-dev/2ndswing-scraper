{
  "name": "2ndswing-scraper",
  "version": "1.0.0",
  "description": "Single-run scraper for 2ndswing.com products listed in a CSV: details, conditional options, price deltas and media.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "fetch-socks": "^1.3.3",
    "p-limit": "^7.3.3",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
